                schema.fieldName,
                modifier = Modifier.weight(1f),
                style = TitleNode.copy(fontSize = 12.sp),
                color = Color(0xFFE0E0E0)
            )

            // metadata contextual
            val hint = buildString {
                schema.unit?.let { append(it) }
